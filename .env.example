# Local development only. Docker Compose reads this file automatically.
POSTGRES_DB=bop
POSTGRES_USER=bop
POSTGRES_PASSWORD=bop_local
# Used by the API when running outside Docker (Compose sets its own DB hostname).
DATABASE_URL=postgresql+psycopg://bop:bop_local@127.0.0.1:5432/bop
MEDIA_ROOT=../../.data/media
MAX_UPLOAD_BYTES=536870912
MEDIA_VALIDATION_TIMEOUT_SECONDS=120
# xAI Grok Speech-to-Text credentials. Leave empty to run without transcription.
# Create a key at https://console.x.ai/. Never commit a real value.
XAI_API_KEY=
# Segment size released to the transcriber, in seconds. Design target, not a latency promise.
SEGMENT_SECONDS=10


# Event history (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
